# This folder holds several unrelated practice projects. The repository tracks
# only the Tokyo DisneySea 3D project (allow-list below); everything else is ignored.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/tools/
!/vercel.json
!/docs/

!/fetch_disneysea.py
!/fetch_disneyland.py
!/disneysea_draft.py
!/disneysea_water_blender.py
!/ds_*.py
!/export_mock.py
!/export_models.py
!/train_blender.py

!/plateau_data/
/plateau_data/*
!/plateau_data/disneysea_osm.json
!/plateau_data/disneyland_osm.json
!/plateau_data/disneyland_levels.json
!/plateau_data/disneysea_levels.json
!/plateau_data/disneysea_water.json
!/plateau_data/disneysea_volcano.json
!/plateau_data/disneysea_plaza.json
!/plateau_data/gsi_dem5a/
# AquaSphere globe textures (from NOAA ETOPO by a one-off script, not regenerable yet)
!/plateau_data/globe/

!/output/
/output/*
!/output/disneysea/
/output/disneysea/*
!/output/disneysea/mock_template.html
!/output/disneysea/tds_outline.html
!/output/disneysea/train.html
!/output/disneysea/models/
/output/disneysea/models/*.glb

__pycache__/
*.blend
*.blend1
