{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "output/disneysea",
  "rewrites": [
    {
      "source": "/",
      "destination": "/tds_outline.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
